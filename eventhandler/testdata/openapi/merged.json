{
  "openapi": "3.1.0",
  "info": {
    "title": "Merged",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/todos": {
      "get": {
        "operationId": "todos_get",
        "parameters": [
          {
            "description": "Page size",
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 10,
              "description": "Page size",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "completed",
            "schema": {
              "type": [
                "null",
                "boolean"
              ]
            }
          },
          {
            "deprecated": true,
            "in": "query",
            "name": "sort",
            "schema": {
              "deprecated": true,
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            }
          },
          {
            "in": "cookie",
            "name": "session",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Trace-Id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Todo"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "GET /todos",
        "tags": [
          "todos"
        ]
      }
    },
    "/users/{id}": {
      "get": {
        "operationId": "users__id__get",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "GET /users/{id}",
        "tags": [
          "users"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          },
          "statusCode": {
            "title": "Status Code",
            "type": "integer"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Todo": {
        "properties": {
          "completed": {
            "type": "boolean"
          },
          "due": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "The todo id",
            "type": "integer"
          },
          "labels": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "title": {
            "examples": [
              "Buy milk"
            ],
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ],
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "tags": [
    {
      "description": "People",
      "name": "users"
    }
  ]
}
