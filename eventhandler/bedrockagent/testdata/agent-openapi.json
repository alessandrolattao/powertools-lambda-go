{
  "openapi": "3.0.3",
  "info": {
    "title": "Powertools API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/claims": {
      "get": {
        "description": "List the open claims",
        "operationId": "claims_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Claim"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "GET /claims"
      }
    },
    "/claims/{claim_id}": {
      "get": {
        "description": "Get a claim",
        "operationId": "claims__claim_id__get",
        "parameters": [
          {
            "description": "The claim",
            "in": "path",
            "name": "claim_id",
            "required": true,
            "schema": {
              "description": "The claim",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Claim"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "GET /claims/{claim_id}",
        "x-requireConfirmation": "ENABLED"
      }
    },
    "/send-reminders": {
      "post": {
        "description": "Send reminders",
        "operationId": "send_reminders_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Reminder"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reminder"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "POST /send-reminders"
      }
    }
  },
  "components": {
    "schemas": {
      "Claim": {
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "closed"
            ],
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          },
          "statusCode": {
            "title": "Status Code",
            "type": "integer"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Reminder": {
        "properties": {
          "channels": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "claimId": {
            "type": "integer"
          },
          "pendingDocuments": {
            "type": "string"
          },
          "previous": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Claim"
              }
            ],
            "nullable": true
          },
          "urgent": {
            "type": "boolean"
          }
        },
        "required": [
          "claimId",
          "pendingDocuments"
        ],
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  }
}
